{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only Src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:ai-stats": "ts-node Src/scripts/seedAIDataThing.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "notes:once": "node work-notes/scripts/generate-work-note.mjs",
    "notes:watch": "node work-notes/scripts/watch-work-notes.mjs",
    "notes:watch:autocommit": "NOTES_AUTO_COMMIT=true node work-notes/scripts/watch-work-notes.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@types/stompit": "^0.26.6",
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.4.1",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "saxes": "^6.0.0",
    "stompit": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/config": "^7.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.2",
    "prisma": "^7.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
